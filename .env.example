# Copy to ".env" in this folder and set the key for the AI you use.
# You can also pick the provider/model and paste keys on the System page.
# https://platform.openai.com/api-keys (also needed for voices)
OPENAI_API_KEY=
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: starting provider (openai | anthropic | local) and model
# PULSE_AI_PROVIDER=openai
# PULSE_AI_MODEL=gpt-4o-mini
# Optional: OpenAI-compatible local server (Ollama default shown; LM Studio is http://localhost:1234/v1)
# LOCAL_AI_BASE_URL=http://localhost:11434/v1
# LOCAL_AI_API_KEY=

# Optional: AbletonMCP (defaults match if omitted)
# ABLETON_MCP_HOST=127.0.0.1
# ABLETON_MCP_PORT=9877

# Optional: if the MCP "smart" path fails, Pulse falls back to AbletonOSC load_device
# (Live Intro: set melodic to an instrument you own, e.g. Simpler, if Wavetable is missing)
# PULSE_OSC_DEFAULT_DRUM=Drum Rack
# PULSE_OSC_DEFAULT_MELODIC=Wavetable
